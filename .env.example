# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (LLM extractor for job postings — free tier 30 RPM, 14400/day)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Anthropic — only needed for Phase 5 LLM class-year classifier in the
# scraper (lib/anthropic/classify.ts). Skip for now; Groq handles the
# main extraction.
ANTHROPIC_API_KEY=sk-ant-...

# Geocoding (Nominatim requires a real User-Agent per their ToS)
NOMINATIM_USER_AGENT=InternshipTracker (your-email@example.com)

# Scraper cron secret (any random 32+ byte hex string; set in GitHub Actions secrets too)
CRON_SECRET=

# (Optional) Jina Reader API key — gets you higher rate limits on r.jina.ai
# Sign up free at https://jina.ai. Leave blank for anonymous usage (still works).
JINA_API_KEY=

# (Optional) Cloudflare Workers Browser Rendering — 4th-layer fallback for
# heavily client-rendered job sites. See cloudflare-worker/README.md.
# Leave blank to skip this layer.
CF_BROWSER_RENDER_URL=
CF_BROWSER_RENDER_TOKEN=

# /api/capture — iOS Shortcut / share-sheet capture flow.
# CAPTURE_SECRET: generate with `openssl rand -hex 24`. Paste the same value
# into the Shortcut's X-Capture-Secret header.
# CAPTURE_USER_ID: your Supabase auth.users.id — captures are hard-wired to
# this user. Find it in the Supabase dashboard → Authentication → Users.
# NEXT_PUBLIC_APP_URL: (optional) canonical origin, used to build the
# detailUrl the Shortcut opens after a successful capture. Defaults to the
# request's own host header.
CAPTURE_SECRET=
CAPTURE_USER_ID=
NEXT_PUBLIC_APP_URL=
